# Copiar a backend/.env para desarrollo local. Nunca subir .env al repositorio.
# En produccion, las variables y claves se configuran en Render (Environment del servicio).

# local o production.
APP_ENV=local
# Render asigna PORT por su cuenta (10000 por defecto); en local se usa 8090.
PORT=8090

# Vacio en local: los correos solo se registran en el log, sin enviarse.
RESEND_API_KEY=

# Clave de prueba oficial de Cloudflare que siempre aprueba.
# Para probar el rechazo, usar 2x0000000000000000000000000000000AA.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

CONTACT_TO=dev@javiervidal.cl
CONTACT_FROM="Portafolio <contacto@javiervidal.cl>"
ALLOWED_ORIGINS=http://localhost:4210

